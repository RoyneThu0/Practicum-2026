# Copy this file to server/.env and fill in real values. server/.env is git-ignored.

# Neon Postgres connection string (Neon dashboard -> Connect). Keep ?sslmode=require on the end.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me

# The public URL people use to reach the site (where /api/auth is served from).
# Production: the Vercel URL (Vercel forwards /api to the Render server).
# Local dev: the Vite dev server, which proxies /api to this server.
BETTER_AUTH_URL=http://localhost:5173

PORT=3000

# Comma-separated emails that get the admin panel (/admin) once they sign in.
# Sign up on the site with one of these emails first.
ADMIN_EMAILS=you@example.com

# Stripe, TEST MODE ONLY (live keys are refused). Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=sk_test_change-me
# Publishable key from the same page. Public by design: the browser uses it to
# show Stripe's payment popup.
STRIPE_PUBLISHABLE_KEY=pk_test_change-me
# Signing secret of the webhook endpoint (Dashboard -> Developers -> Webhooks),
# or the whsec_… printed by `stripe listen` when testing locally.
STRIPE_WEBHOOK_SECRET=whsec_change-me
# Currency for slot prices (three letters). Prices are stored in cents.
STRIPE_CURRENCY=usd
